# App Configuration
APP_NAME=Procurement AI Assistant
ENV=development
DEBUG=true
LOG_LEVEL=INFO
API_V1_STR=/api/v1
SECRET_KEY=change-this-ultra-secure-secret-key-in-production-32chars

# Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=procurement_user
POSTGRES_PASSWORD=procurement_pass
POSTGRES_DB=procurement_ai_db
DATABASE_URL=postgresql+asyncpg://procurement_user:procurement_pass@localhost:5432/procurement_ai_db

# Redis & Event Bus Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
EVENT_BUS_TYPE=redis  # memory or redis

# LLM Provider (LiteLLM)
OPENAI_API_KEY=sk-proj-mock-or-real-key
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Observability
ENABLE_TELEMETRY=true
LANGFUSE_PUBLIC_KEY=lf_pk_mock
LANGFUSE_SECRET_KEY=lf_sk_mock
LANGFUSE_HOST=http://localhost:3000

# File Upload Settings
MAX_UPLOAD_SIZE_MB=10
ALLOWED_FILE_TYPES=pdf
